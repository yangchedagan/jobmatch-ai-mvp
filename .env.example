NODE_ENV=production
DEMO_MODE=true
HOST=0.0.0.0
PORT=5173

# Set to your deployed origin, for example:
# CORS_ORIGIN=https://jobmatch-ai-mvp.onrender.com
CORS_ORIGIN=

# Optional. When set, admin-only API routes require this token in X-Admin-Token
# or Authorization: Bearer <token>.
ADMIN_TOKEN=

# Optional. Use this to isolate runtime JSON files in tests or self-hosting.
# JOBMATCH_DATA_DIR=/var/data/jobmatch
JOBMATCH_DATA_DIR=

# Optional. Enables Qwen (Alibaba Bailian) analysis, agent routing, and chat.
# OpenAI-compatible endpoint. Default is the public DashScope endpoint; use your
# workspace endpoint if you have one.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_MS=20000
QWEN_JSON_RETRIES=3

# Agent chat session TTL in milliseconds (in-memory only).
AGENT_SESSION_TTL_MS=1800000

# Deprecated: DeepSeek settings kept for reference; the app now uses Qwen.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_JSON_RETRIES=3

# Optional. Server-side semantic matching with @xenova/transformers.
SEMANTIC_MATCH_ENABLED=true
SEMANTIC_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_MATCH_THRESHOLD=0.66
SEMANTIC_MATCH_TIMEOUT_MS=20000
